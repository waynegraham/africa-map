{
  "version": 8,
  "name": "CLIR Research Atlas",
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "attribution": "<a href=\"https://openfreemap.org/\">OpenFreeMap</a> \u00b7 <a href=\"https://openmaptiles.org/\">OpenMapTiles</a> \u00b7 \u00a9 <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap contributors</a>"
    }
  },
  "layers": [
    {
      "id": "atlas-paper",
      "type": "background",
      "paint": {
        "background-color": "#fafbfc"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "paint": {
        "fill-color": "#e8eee8",
        "fill-opacity": 0.55
      },
      "minzoom": 0,
      "filter": [
        "in",
        "class",
        "wood",
        "grass",
        "scrub"
      ]
    },
    {
      "id": "parks",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#e3ebe4",
        "fill-opacity": 0.6
      },
      "minzoom": 8
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#dce7f2"
      },
      "minzoom": 0
    },
    {
      "id": "waterways",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#b7cadf",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          6,
          0.3,
          14,
          1.5
        ]
      },
      "minzoom": 0
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "paint": {
        "fill-color": "#dce1e7",
        "fill-opacity": 0.65
      },
      "minzoom": 13
    },
    {
      "id": "roads",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "paint": {
        "line-color": "#d6dce4",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          6,
          0.3,
          15,
          2
        ]
      },
      "minzoom": 6,
      "filter": [
        "!=",
        "class",
        "rail"
      ]
    },
    {
      "id": "major-roads",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "paint": {
        "line-color": "#c3cdd8",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          5,
          0.4,
          15,
          3
        ]
      },
      "minzoom": 5,
      "filter": [
        "in",
        "class",
        "motorway",
        "trunk",
        "primary"
      ]
    },
    {
      "id": "boundaries",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "paint": {
        "line-color": "#adb9c7",
        "line-width": 0.8,
        "line-dasharray": [
          4,
          3
        ]
      },
      "minzoom": 0,
      "filter": [
        "<=",
        "admin_level",
        4
      ]
    },
    {
      "id": "label-country",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 1,
      "filter": [
        "==",
        "class",
        "country"
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 14,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#596875",
        "text-halo-color": "#fafbfc",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "label-state",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 5,
      "filter": [
        "==",
        "class",
        "state"
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 11,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#596875",
        "text-halo-color": "#fafbfc",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "label-city",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 3,
      "filter": [
        "==",
        "class",
        "city"
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 13,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#596875",
        "text-halo-color": "#fafbfc",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "label-town",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 7,
      "filter": [
        "==",
        "class",
        "town"
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 11,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#596875",
        "text-halo-color": "#fafbfc",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "label-village",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 10,
      "filter": [
        "==",
        "class",
        "village"
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 10,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#596875",
        "text-halo-color": "#fafbfc",
        "text-halo-width": 1.5
      }
    }
  ]
}
